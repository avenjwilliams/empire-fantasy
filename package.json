{
  "name": "empire-fantasy",
  "private": true,
  "workspaces": ["shared", "server", "client"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "stats:week": "tsx scripts/ingest-week.ts",
    "rankings:export": "tsx scripts/export-rankings.ts",
    "rankings:import": "tsx scripts/import-rankings.ts",
    "rankings:rebase": "tsx scripts/rebase-precision.ts",
    "snapshot": "tsx scripts/snapshot-history.ts",
    "volatility:generate": "tsx scripts/generate-volatility.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
